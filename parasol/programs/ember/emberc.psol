; emberc.psol -- the Ember compiler: source in, ARM64 assembly out.
;
;     solvm emberc.sob examples/fizzbuzz.em > fizzbuzz.s && cc fizzbuzz.s
;
; Written in Parasol, which is the point. What the dialects buy and what they
; cost is in README.md under "What it found".

@use "asm.psol".
@use "../../lib/control.psol".

@include "scan.sol".
@include "text.sol".

; ---------------------------------------------------------------- the lexer

digits := "0123456789".
letters := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".

isDigit := { c | c:notNil && digits:indexOf(c):notNil }.
isLetter := { c | c:notNil && letters:indexOf(c):notNil }.
isSpace := { c | c:notNil && " \t\n\r":indexOf(c):notNil }.

token := { kind, text | | t |
    t := object:new. t:kind := kind. t:text := text. t }.

lex := { src | | s, out, c, two |
    s := scan:on(src).
    out := array:new.
    { s:atEnd:not }:whileTrue({
        c := s:peek.
        if isSpace:value(c) then s:step
        else if c == "#" then s:takeUntil({ ch | ch == "\n" })
        else if isDigit:value(c) then
            out:add(token:value('num, s:takeWhile({ ch | isDigit:value(ch) })))
        else if isLetter:value(c) then
            out:add(token:value('name, s:takeWhile({ ch |
                isLetter:value(ch):or({ isDigit:value(ch) }) })))
        else if c == "\"" then (
            s:step.
            out:add(token:value('str, s:takeUntil({ ch | ch == "\"" }))).
            s:step)
        else (
            two := s:peekAt(#1).
            if two:notNil:and({ "=<>!":indexOf(c):notNil:and({ two == "=" }) }) then (
                out:add(token:value('op, c:concat(two))). s:step. s:step)
            else (out:add(token:value('op, c)). s:step)) }).
    out:add(token:value('end, "")).
    out }.

; --------------------------------------------------------------- the parser
;
; Recursive descent over the token array. Ember has `end` on its blocks, which
; Parasol's own forms do not need -- an expression nests without a terminator
; and a hand-written parser wants one. Two languages, two answers, and the
; contrast is the sort of thing writing this was for.

tokens := array:new.
pos := #1.

tkPeek := { tokens:at(pos) }.
tkNext := { | t | t := tokens:at(pos). pos := pos + #1. t }.
tkIs := { kind, text | | t | t := tkPeek:value.
    t:kind == kind && t:text == text }.

fail := { why | | t |
    t := tkPeek:value.
    "emberc: {} at '{}'":fill([why, t:text]):display.
    system:exit(#65) }.

expect := { kind, text |
    if !tkIs:value(kind, text) then fail:value("expected '":concat(text):concat("'")).
    tkNext:value }.

node := { kind | | n | n := object:new. n:kind := kind. n }.

binNode := { op, left, right | | n |
    n := node:value('bin). n:op := op. n:left := left. n:right := right. n }.

; The four levels of the expression grammar, tightest last.
parseExpr := { parseCmp:value }.

parseCmp := { | left, op |
    left := parseSum:value.
    { tkPeek:value:kind == 'op
        && ["<", ">", "<=", ">=", "==", "!="]:indexOf(tkPeek:value:text):notNil
    }:whileTrue({
        op := tkNext:value:text.
        left := binNode:value(op, left, parseSum:value) }).
    left }.

parseSum := { | left, op |
    left := parseTerm:value.
    { tkPeek:value:kind == 'op
        && ["+", "-"]:indexOf(tkPeek:value:text):notNil
    }:whileTrue({
        op := tkNext:value:text.
        left := binNode:value(op, left, parseTerm:value) }).
    left }.

parseTerm := { | left, op |
    left := parseAtom:value.
    { tkPeek:value:kind == 'op
        && ["*", "/", "%"]:indexOf(tkPeek:value:text):notNil
    }:whileTrue({
        op := tkNext:value:text.
        left := binNode:value(op, left, parseAtom:value) }).
    left }.

parseAtom := { | t, n |
    t := tkNext:value.
    if t:kind == 'num then (n := node:value('num). n:value := t:text:asInteger. n)
    else if t:kind == 'name then (n := node:value('var). n:name := t:text. n)
    else if t:kind == 'str then (n := node:value('str). n:text := t:text. n)
    else if t:kind == 'op && t:text == "(" then (
        n := parseExpr:value.
        expect:value('op, ")").
        n)
    else (fail:value("expected an expression"). nil) }.

parseBlock := { | out |
    out := array:new.
    { !(tkPeek:value:kind == 'end)
        && !tkIs:value('name, "end")
        && !tkIs:value('name, "else")
    }:whileTrue({ out:add(parseStmt:value) }).
    out }.

parseStmt := { | n |
    if tkIs:value('name, "let") then (
        tkNext:value.
        n := node:value('let).
        n:name := tkNext:value:text.
        expect:value('op, "=").
        n:expr := parseExpr:value.
        n)
    else if tkIs:value('name, "print") then (
        tkNext:value.
        n := node:value('print). n:expr := parseExpr:value. n)
    else if tkIs:value('name, "if") then (
        tkNext:value.
        n := node:value('if).
        n:cond := parseExpr:value.
        expect:value('name, "then").
        n:then := parseBlock:value.
        n:else := array:new.
        if tkIs:value('name, "else") then (tkNext:value. n:else := parseBlock:value).
        expect:value('name, "end").
        n)
    else if tkIs:value('name, "while") then (
        tkNext:value.
        n := node:value('while).
        n:cond := parseExpr:value.
        expect:value('name, "do").
        n:body := parseBlock:value.
        expect:value('name, "end").
        n)
    else (fail:value("expected a statement"). nil) }.

; ------------------------------------------------------------- the compiler

out := array:new.
vars := array:new.
strings := array:new.
labels := #0.

slotFor := { name |
    if vars:indexOf(name):isNil then vars:add(name).
    vars:indexOf(name) }.

nextLabel := { labels := labels + #1. labels }.

stringFor := { text |
    if strings:indexOf(text):isNil then strings:add(text).
    strings:indexOf(text) }.

; The comparison a token spells, as the condition code ARM64 spells it.
condFor := { op |
    if op == "<" then "lt"
    else if op == ">" then "gt"
    else if op == "<=" then "le"
    else if op == ">=" then "ge"
    else if op == "==" then "eq"
    else "ne" }.

genExpr := { e |
    if e:kind == 'num then load "x0" imm e:value
    else if e:kind == 'var then load "x0" slot slotFor:value(e:name)
    else if e:kind == 'str then
        load "x0" adr "Lstr":concat(stringFor:value(e:text):asString)
    else (
        genExpr:value(e:left).
        push "x0".
        genExpr:value(e:right).
        emit("    mov x1, x0").
        pop "x0".
        if ["<", ">", "<=", ">=", "==", "!="]:indexOf(e:op):notNil then (
            compare "x0" with "x1".
            set "x0" when condFor:value(e:op))
        else if e:op == "+" then binop("add", "x0", "x0", "x1")
        else if e:op == "-" then binop("sub", "x0", "x0", "x1")
        else if e:op == "*" then binop("mul", "x0", "x0", "x1")
        else if e:op == "/" then binop("sdiv", "x0", "x0", "x1")
        else (
            binop("sdiv", "x2", "x0", "x1").
            emit("    msub x0, x2, x1, x0"))) }.

genStmt := { n | | done, top, other |
    if n:kind == 'let then (
        genExpr:value(n:expr).
        store "x0" slot slotFor:value(n:name))
    else if n:kind == 'print then (
        genExpr:value(n:expr).
        push "x0".
        if n:expr:kind == 'str then load "x0" adr "fmt_str"
        else load "x0" adr "fmt_int".
        call "_printf".
        emit("    add sp, sp, #16"))
    else if n:kind == 'if then (
        other := nextLabel:value.
        done := nextLabel:value.
        genExpr:value(n:cond).
        goto other ifzero "x0".
        n:then:do({ s | genStmt:value(s) }).
        goto done.
        label other.
        n:else:do({ s | genStmt:value(s) }).
        label done)
    else (
        top := nextLabel:value.
        done := nextLabel:value.
        label top.
        genExpr:value(n:cond).
        goto done ifzero "x0".
        n:body:do({ s | genStmt:value(s) }).
        goto top.
        label done) }.

; ------------------------------------------------------------------- driver

args := system:arguments.
if args:size < #1 then (
    "usage: emberc <file.em>":display.
    system:exit(#64)).

tokens := lex:value(system:readFile(args:at(#1))).
program := parseBlock:value.

; The body first, so that the frame is sized after the variables are known.
body := array:new.
out := body.
program:do({ s | genStmt:value(s) }).

out := array:new.
emit(".section __TEXT,__text").
emit(".globl _main").
emit(".align 2").
emit("_main:").
emit("    stp x29, x30, [sp, #-16]!").
emit("    mov x29, sp").
emit("    sub sp, sp, #{}":fill([vars:size:add(#1):div(#2):add(#1):mul(#16)])).
body:do({ line | out:add(line) }).
emit("    mov sp, x29").
emit("    mov w0, #0").
emit("    ldp x29, x30, [sp], #16").
emit("    ret").
emit(".section __TEXT,__cstring").
emit("fmt_int: .asciz \"%ld\\n\"").
emit("fmt_str: .asciz \"%s\\n\"").
strings:do({ s | | i |
    i := strings:indexOf(s).
    emit("Lstr{}: .asciz \"{}\"":fill([i, s])) }).

out:do({ line | line:display }).
