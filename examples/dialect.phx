; dialect.phx -- a module that declares almost nothing and reads like a
; language anyway.
;
; The header is two lines. Everything the body uses -- the operators, the
; precedences, `unless`, `while` -- comes out of lib/, and lib/control.phx in
; turn uses lib/arith.phx. Two files deep, and the diamond costs nothing: arith
; is read once.

@language solveig.
@use "../lib/control.phx".

n := #7.

unless(n > #10, "seven is not more than ten":print).
when(n % #2 == #1, "and it is odd":print).

i := #1.
total := #0.
while(i < n, (total := total + i. i := i + #1)).
total:print.                     ; #21, being 1+2+3+4+5+6

a := "left".
b := "right".
swap(a, b).
a:print.                         ; "right"
b:print.                         ; "left"
