' How a number is written. Types are said outright, because QBasic's default
' numeric type is SINGLE and SolaBasic's is DOUBLE -- a bare name would not be
' the same variable in the two languages, and this file is about PRINT.
DEFINT A-Z
PRINT 0
PRINT 14
PRINT -7
PRINT 32767
PRINT -32768
DIM x AS DOUBLE
x = 2.5
PRINT x
x = -2.5
PRINT x
x = .5
PRINT x
x = -.5
PRINT x
END
